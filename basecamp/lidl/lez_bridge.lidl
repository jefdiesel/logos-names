module lez_bridge {
  version "0.1.0"
  depends []

  method config() -> tstr description "The settings and what is ready: `{module_version, sequencer, eth_rpc, eth_proof_rpc,\neth_source, deployment, cli, wallet_dir, proving, fixtures, ready: {cli, wallet, why}}`."
  method set_eth_rpc(chain_id: tstr, url: tstr) -> tstr description "The Ethereum JSON-RPC used for chain `chain_id` (decimal text), e.g. `11155111`."
  method set_eth_proof_rpc(chain_id: tstr, url: tstr) -> tstr description "The Ethereum JSON-RPC that serves `eth_getProof` well behind the head (for claims)."
  method set_eth_source(source: tstr) -> tstr description "Where Ethereum reads come from: `rpc`, or `logos_module` (the Logos Ethereum module; not\nwired in this build, and says so)."
  method set_sequencer(url: tstr) -> tstr description "The LEZ sequencer (http/https). Loopback only while the CLI refuses anything else."
  method set_cli(program: tstr, wallet_dir: tstr) -> tstr description "The `lez-bridge` program and the wallet folder it uses (its `LEE_WALLET_HOME_DIR`)."
  method use_deployment(source: tstr) -> tstr description "The bridge deployment: a built-in name (`sepolia-demo-v2`), a path to a deployment JSON\nfile, or the JSON itself."
  method set_fixtures(dir: tstr) -> tstr description "Serve recorded replies from folder `dir` (\"\" turns fixture mode off)."
  method registry() -> tstr description "The registry on both sides: tokens with denominations, fees, the relay-fee menu, caps\nand current usage, cap weights, freeze state on Ethereum and LEZ, the release delay,\nthe LEZ float and sponsor amount, and the attestation instance (latest anchor and age)."
  method plan_deposit(token: tstr, amount: tstr) -> tstr description "A split of `amount` (human text, e.g. `1,250.5`) of `token` (symbol or address) into the\nvault's denominations, a staggered sending schedule, fees and a privacy report."
  method make_deposit_request(token: tstr, denom_index: tstr, account: tstr) -> tstr description "A deposit request for one denomination (`denom_index`) to LEZ account `account`: the\ncommitment, the vault call (and the ERC-20 approval), an EIP-681 link and its QR, and an\nexport text. A fresh secret is kept on this computer only."
  method make_public_deposit_request(token: tstr, denom_index: tstr, account: tstr, confirm_weaker: tstr) -> tstr description "The same for a PUBLIC LEZ account, which `make_deposit_request` refuses: claiming into a\npublic account publishes the deposit's secret and links the two sides for good, so this\nneeds `confirm_weaker` = \"true\". With the Names Wallet: a public account given to this app\n(`Public/<id>`), its secret from `app_secret` of that account; the reply adds `not_private`\n(the notice to show before the person deposits). Its claim is the relayed public claim."
  method import_deposit(deposit_json: tstr) -> tstr description "Adds a deposit made elsewhere: `{secret, account, token, denom_index}`. Until the CLI\nderives secrets from the seed, this is how a deposit from another install is claimed."
  method deposits() -> tstr description "This computer's deposits, each with its stage and timeline (sent → finalized → anchor\nrecorded → suggested claim time → claimed) and its anonymity set."
  method claim_plan(id: tstr) -> tstr description "The claim of deposit `id`, checked by a dry run (nothing proven or sent): one-time\nrecipient, sponsorship, fee, the local diagnosis if it would be refused, proving cost."
  method claim(id: tstr, options_json: tstr) -> tstr description "Starts the claim of deposit `id` as a job: `options_json` `{reveal_recipient,\nclaim_early, confirm_weaker, dry_run}`. Any choice that weakens privacy needs\n`confirm_weaker: true`. Returns the job."
  method jobs() -> tstr description "Every job, newest first."
  method job(id: tstr) -> tstr description "One job: `{id, kind, state, phase, phases, elapsed_s, prove_estimate_s, peak_rss_mb,\nlog_tail, result, error, can_pause, can_resume, can_cancel}`."
  method pause_job(id: tstr) -> tstr
  method resume_job(id: tstr) -> tstr
  method cancel_job(id: tstr) -> tstr
  method holdings() -> tstr description "The wrapped tokens this wallet holds, per account (private first), from a cache the\nmodule refreshes in the background (`as_of`, `stale`, `refreshing`)."
  method accounts() -> tstr description "The wallet's accounts and their kind, to choose a claim target (private pre-selected)."
  method plan_redeem(token: tstr, amount: tstr, eth_to: tstr, relay_fee_index: tstr) -> tstr description "A redemption plan: `amount` of `token` to Ethereum address `eth_to`, relay fee choice\n`relay_fee_index` (\"0\" none, \"1\".. the menu), split into burns, with warnings about\nthe recipient and what the vault can release."
  method redeem(plan_id: tstr, options_json: tstr) -> tstr description "Starts the burns of plan `plan_id` as a job (`options_json` as for `claim`)."
  method exits() -> tstr description "Burns this computer made, and what each waits for on Ethereum."
  method release(exit_id: tstr, relayer_json: tstr) -> tstr description "Releasing an exit on Ethereum. Not possible yet: the outbound proof (G2) is not built.\nAnswers that plainly, with what is missing."
  method recover(account: tstr, gap_limit: tstr) -> tstr description "Finds this account's positions again (`gap_limit` deposits past the last one found)."
  method privacy_report(choices_json: tstr) -> tstr description "What is public and what each chosen override leaks: `choices_json` `{flow, <override>:\ntrue, anonymity_set}` (see privacy.rs). An empty choice is the private default."
  method admin_status() -> tstr description "Roles on both sides, whether this wallet holds the LEZ admin or freezer key, the state an\nadmin manages, and which operations this build offers."
  method admin_action(action_json: tstr) -> tstr description "One admin operation: `{op, ...}` with op `freeze`, `unfreeze` (`mint`, `burn`, `token`),\n`set_sponsor` (`amount`), `fund_float` (`amount`, `from`), `register_token`\n(`eth_token`, `definition`, `decimals`, `denoms`), or an Ethereum-side op, which this\nbuild does not offer and says so."
  method wallet_status() -> tstr description "Where the accounts are and what the Names Wallet has granted: `{mode, connected,\naccounts: [{account, kind}], token_source: {accepted, request}, needs}`. In `names` mode,\nonce connected, this also proposes the bridged tokens as a token source (first run)."
  method wallet_connect() -> tstr description "Asks the Names Wallet for access (`request_access`): the request to watch."
  method wallet_request(request_id: tstr) -> tstr description "How a Names Wallet request this module made stands (`request_status`, in general terms)."
  method set_wallet_mode(mode: tstr) -> tstr description "`names` (the Names Wallet) or `cli` (the lez-bridge CLI's own wallet folder)."
  method relayed_claim_check(claim: tstr) -> tstr description "Checks a claim file the deposit page saved, given as its JSON text or as a file path\n(`file://…` too), and everything a relayed claim needs, reading only: the bridge on LEZ,\nthe deposit's leaf on Sepolia (final), a recorded root, the nullifier unspent, the\nrelay's payer and caps. Builds the call the wallet will sign. Nothing is proposed,\nsigned or sent (the dry run). `{ok, id, deposit, network, relay, call, checks, wallet,\nprivacy, wording, error: {code, message}}`; the claim key stays in memory under `id`."
  method relayed_claim_check_with(claim: tstr, options_json: tstr) -> tstr description "`relayed_claim_check` with options (`options_json`): `{\"wallet_hint\": false}` skips the\nreply's `wallet` part (`{\"skipped\": true, \"needs\": null}`), so the check asks the Names\nWallet nothing and never waits on it: for a caller that is the wallet (the Names app).\n`{}` is the same as `relayed_claim_check`. A separate method because a generated method\ntakes a fixed number of arguments."
  method relayed_claim(check_id: tstr, options_json: tstr) -> tstr description "Proposes the checked claim `check_id` to the Names Wallet (`propose_relayed_call`), after\nits gates (connected, the account given to this app, the programs declared, LEZ 0.4):\n`{needs, request, message}` while the person has something to approve, else the job.\nSafe to call again after a timeout: a claim that has a running job gets that job back, and\nafter a proposal that got no answer it answers `{needs: \"uncertain\", uncertain, message}`\nuntil `options_json` is `{\"after_uncertain\": true}` (the person looked in the Names app) or\n11 minutes passed. A busy wallet is asked again (2, 4, 6, 8 s; 30 s at most)."
  method receive_status(id: tstr) -> tstr description "\"Receive from Ethereum\": where stored deposit `id` stands, for a 60 s poll: `{stage:\nrequested|deposited|final|claimable|claimed, text, leaf, block, tx, confirmations,\nfinal_in_min, claimed_block, claim: relayed|private, reads: {sepolia, lez}}`. Claimable is\na root the bridge recorded on LEZ (as the relayed check), claimed is the deposit's\nnullifier account; no wallet call. Sepolia logs are read again only when the vault's count\nmoved."
  method relayed_claim_check_deposit(id: tstr, options_json: tstr) -> tstr description "`relayed_claim_check` for stored deposit `id` (a public account's, made by the Names\nWallet): its claim key from `app_secret` instead of a claim file. Same reply and `id`;\n`{needs: \"secret\", …}` while the person approves this app's values first. `options_json`\nas `relayed_claim_check_with` (`{\"wallet_hint\": false}`)."
  method receives() -> tstr description "This install's \"Receive from Ethereum\" deposits (made by the Names Wallet's secret, or\nfound by `recover`), newest first: `{receives: [{id, symbol, denom, denom_text, decimals,\namount_text, account, account_kind, commitment, created, key_index, claim, claimed, stage,\ntext, leaf, block, tx, claimed_block, as_of}]}` with the stage `receive_status` last saw\n(`unknown` before its first call). No chain or wallet read."
  method relayed_claim_build(check_id: tstr) -> tstr description "For a host that signs the claim itself (the Names app, `modules/NAMES-EMBED.md` Part B): the\ncall for checked claim `check_id`, exactly `propose_relayed_call`'s input: `{check, account,\ncall: {program, message, accounts, fee: {payer, gas_limit, tip, max_fee}, privacy}, summary,\nnetwork, deployment, bridge_program, token_program, watch, wording, privacy}`. Asks no\nwallet, sends nothing. The message carries the claim key (the claim reveals it)."
  method relayed_claim_submit(check_id: tstr, transaction: tstr) -> tstr description "For that host: its half-signed `transaction` (hex) of checked claim `check_id`. Starts the\nclaim job at the relay phase (or gives a job that says `needs: \"sign_again\"` its new\nsignature); then `relayed_claim_status`. Returns the job."
  method relayed_claim_status(job_id: tstr) -> tstr description "Claim job `job_id`, moved on as far as it can go now: approved in the wallet, handed to\nthe relay, in a block. `{id, state, phase, phases, note, tx, block, result, error}`."
  method relayed_claims() -> tstr description "Every relayed claim job, newest first."
  method relayed_claim_cancel(job_id: tstr) -> tstr description "Cancels claim job `job_id` while it waits for the person's approval."
  method relayed_claim_forget(check_id: tstr) -> tstr description "Forgets checked claim `check_id` (its claim key leaves memory)."
}
