{
  "name": "names_ui",
  "display_name": "Names",
  "version": "0.6.0",
  "type": "ui_qml",
  "category": "identity",
  "description": "Find, register and manage private .LEZ names",
  "view": "Main.qml",
  "icon": "src/icons/icon.png",
  "dependencies": [
    "names"
  ],
  "provides": [
    {
      "intent": "names.open",
      "params": [
        {
          "name": "name",
          "type": "string",
          "required": true
        }
      ],
      "handoff": true,
      "web": true
    }
  ],
  "uses": [
    {
      "intent": "basecamp.apps.launch"
    }
  ],
  "nix": {
    "packages": {
      "build": [],
      "runtime": []
    },
    "external_libraries": [],
    "cmake": {
      "find_packages": [],
      "extra_sources": [],
      "extra_include_dirs": [],
      "extra_link_libraries": []
    }
  }
}
