<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/jef</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>local.lez-tunnel</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/jef/lez-chain/bin/cloudflared</string>
		<string>tunnel</string>
		<string>--no-autoupdate</string>
		<string>run</string>
		<string>--token-file</string>
		<string>/Users/jef/lez-chain/tunnel-token</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/jef/Library/Logs/local.lez-tunnel.log</string>
	<key>StandardOutPath</key>
	<string>/Users/jef/Library/Logs/local.lez-tunnel.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>/Users/jef/lez-chain</string>
</dict>
</plist>
