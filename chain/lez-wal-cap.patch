+        // Families written a little each block never fill a memtable, so without a
+        // cap every write-ahead log stays on disk until the default limit of several
+        // GB. Flushing at 256 MB keeps the logs small.
+        db_opts.set_max_total_wal_size(256 * 1024 * 1024);
+        // Keeping every table file open (the default) needs more descriptors than
+        // launchd grants (256 soft, 10240 per process), and once opens fail,
+        // compaction stops and each crash-restart leaves more files behind.
+        db_opts.set_max_open_files(200);
+        db_opts.set_keep_log_file_num(10);
